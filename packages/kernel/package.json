    "./hub": "./src/hub.ts",
    "./client": "./src/client.ts",
    "./types": "./src/types.ts",
    "./auth": "./src/auth.ts",
    "./tincan": "./src/tincan.ts",
    "./storage": "./src/storage/index.ts",
    "./storage/types": "./src/storage/types.ts",
    "./storage/d1": "./src/storage/d1.ts",
    "./storage/sqlite": "./src/storage/sqlite.ts"
