{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "authority-seo-pod",
  "main": "src/worker.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "authority-seo-pod-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  // Optional: bind a hub worker as FACTORY_HUB and an Orrery worker as ORRERY via "services",
  // and set INDEXNOW_KEY / FACTORY_HUB_URL / ORRERY_URL in "vars". The pod runs without them.
  // Keep deployment-specific ids and URLs out of this public template.
  "vars": {
    "POD_ID": "authority-seo-pod",
    "POD_NAME": "Authority Seo Pod",
    "POD_ROLE": "seo",
    "POD_LOB": "authority-network",
    "FACTORY_HUB_URL": "",
    "ORRERY_URL": ""
  },
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "0 */4 * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
