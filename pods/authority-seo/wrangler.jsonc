{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "authority-seo-pod",
  "main": "src/worker.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "authority-seo-pod-db",
      "database_id": "5b4a48ca-a3bc-419b-bb4d-a3fc44a2de94"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "services": [
    {
      "binding": "FACTORY_HUB",
      "service": "factory-hub"
    },
    {
      "binding": "ORRERY",
      "service": "orrery"
    }
  ],
  "vars": {
    "POD_ID": "authority-seo-pod",
    "POD_NAME": "Authority Seo Pod",
    "POD_ROLE": "seo",
    "POD_LOB": "authority-network",
    "FACTORY_HUB_URL": "https://factory-hub.walterhudson462.workers.dev",
    "ORRERY_URL": "https://orrery.walterhudson462.workers.dev"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "0 */4 * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
