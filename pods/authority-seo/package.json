{
  "name": "authority-seo-pod",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous SEO governance pod: audits, AI-crawler robots.txt, Schema.org JSON-LD, IndexNow",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "serve": "tsx src/main.ts serve",
    "test": "tsx --import ../../tests/support/no-network.mjs --test tests/**/*.test.ts",
    "check": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "scaffold": "node bin/scaffold.js"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "@futr-work/pod-kernel": "^0.1.0"
  }
}
