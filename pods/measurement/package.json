{
  "name": "measurement-pod",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Autonomous low-frequency measurement and evidence pod: typed multi-family observations, immutable provenance, coverage/reconciliation, MCP v2 + Code Mode, and Worldview-ready projection",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "serve": "tsx src/main.ts serve",
    "test": "tsx --import ../../tests/support/no-network.mjs --test tests/**/*.test.ts",
    "smoke:runtime": "tsx --import ../../tests/support/no-external-network.mjs scripts/smoke-runtime.ts",
    "check": "tsc --noEmit",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "@futr-work/pod-kernel": "^0.2.0"
  }
}
